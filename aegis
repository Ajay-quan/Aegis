#!/usr/bin/env bash
# Aegis local stack: AegisTrace + AegisMem + dashboard, one command.
#   ./aegis up      start everything (first run creates dev keys and tokens); --observability adds Grafana
#   ./aegis demo    load demo activity (runs, a blocked action, governed memory, a pending approval)
#   ./aegis token   print a dashboard sign-in token (dev only, expires in 8h)
#   ./aegis open    open the dashboard
#   ./aegis test    run every test suite against the running stack
#   ./aegis rotate-keys  rotate the checkpoint signing key and refresh the trust store
#   ./aegis down    stop everything (data is kept; add -v to delete it)
set -euo pipefail
cd "$(dirname "$0")"
T=AegisTrace

# iCloud-synced folders corrupt Python virtualenvs (hidden or duplicated .pth
# files, so imports fail). Keep the env in .venv.nosync, which iCloud skips,
# and point .venv at it so plain `uv run` works too.
pyenv() {
  (cd "$T" && if [ ! -L .venv ]; then
     if [ -d .venv ]; then mv .venv ".venv-old-$$.nosync"; (rm -rf ".venv-old-$$.nosync" &); fi
     UV_PROJECT_ENVIRONMENT=.venv.nosync uv sync -q && ln -sfn .venv.nosync .venv
   else uv sync -q; fi)
}

need() { command -v "$1" >/dev/null || { echo "missing: $1 ($2)"; exit 1; }; }

bootstrap() {
  need docker "https://docs.docker.com/get-docker/"; need uv "https://docs.astral.sh/uv/"
  docker compose up -d --wait postgres redis opa
  docker compose run --rm --build migrate >/dev/null  # schema first (rebuilt, so new migrations apply): bootstrap writes the demo tenant and its members
  # Idempotent: keeps existing dev keys, (re)provisions the demo tenant, mints fresh 8h tokens.
  pyenv && (cd "$T" && uv run python scripts/dev_bootstrap.py >/dev/null)
}

case "${1:-help}" in
  up)
    if [ "${2:-}" = "--observability" ]; then
      export COMPOSE_PROFILES=observability OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
    fi
    bootstrap
    docker compose up -d --build --wait
    # AegisTrace's service key for AegisMem (created once; AegisMem stores only its hash).
    if [ ! -s "$T/.dev/secrets/aegismem-key" ]; then
      docker compose exec -T aegismem python scripts/aegisctl.py create-key --tenant aegistrace \
        --name aegistrace-service --scopes memory:read memory:write review privacy \
        | sed -n 's/^api_key: //p' > "$T/.dev/secrets/aegismem-key"
      chmod 644 "$T/.dev/secrets/aegismem-key"  # read by the API and worker containers (dev only)
      docker compose up -d --wait --force-recreate api worker >/dev/null
    fi
    echo; echo "Aegis is running."
    echo "  Dashboard  http://localhost:3000   (click Sign in; dev users: admin, auditor)"
    echo "  API        http://localhost:8000/docs"
    echo "  Demo data  ./aegis demo"
    [ -n "${COMPOSE_PROFILES:-}" ] && echo "  Grafana    http://localhost:3002   (AegisTrace overview dashboard; traces per run)"
    true
    ;;
  demo)
    pyenv
    (cd "$T" && uv run python scripts/seed_demo.py && ./examples/governed_memory/run.sh >/dev/null && echo "governed memory demo loaded")
    ;;
  test)
    pyenv
    COMPOSE_PROJECT_NAME=aegis bash "$T/scripts/test_db.sh" >/dev/null
    echo "== AegisTrace (Python)";  (cd "$T" && uv run pytest -q)
    tok="$("$0" token)"; [ -n "$tok" ] || { echo "no dev token: run ./aegis up first"; exit 1; }
    echo "== AegisTrace dashboard"; (cd "$T/apps/dashboard" && npm run build >/dev/null && AEGIS_TOKEN="$tok" \
      AEGIS_TEST_OIDC_DISCOVERY=http://localhost:9000/.well-known/openid-configuration npx playwright test --reporter=list \
      | tee /dev/stderr | { ! grep -qE "^ +[0-9]+ skipped"; })  # a skipped browser test means the stack is not wired; fail
    echo "== AegisMem extension";   (cd AegisMem/extension && npm test --silent)
    ;;
  rotate-keys)
    # New active signing key in the signing service; the old one keeps signing for a short grace
    # period, then verifiers accept it only for checkpoints made before it was retired.
    docker compose exec -T signer aegistrace-signer rotate --keys /keys
    pyenv && (cd "$T" && uv run aegistrace-signer trust-store --keys .dev/signer -o .dev/trust.json)
    echo "Trust store updated: $T/.dev/trust.json (publish it to verifiers)"
    ;;
  token) python3 -c "import json;print(json.load(open('$PWD/$T/.dev/tokens.json'))['user'])" ;;
  open) open http://localhost:3000 2>/dev/null || xdg-open http://localhost:3000 ;;
  down) shift; docker compose down "$@" ;;
  *) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
