{
  "name": "@aegismem/client",
  "version": "0.1.0",
  "description": "Official TypeScript client for AegisMem, the trust layer for agent memory",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "@types/node": "22.7.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ajay-quan/AegisMem",
    "directory": "sdk/typescript"
  }
}
