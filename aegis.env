# Settings passed to AegisTrace's compose file when run from the Aegis root.
# Connects AegisTrace's memory.* tools to the AegisMem service in compose.yaml.
AEGIS_MEMORY_URL=http://aegismem:8000
# Service key AegisTrace uses to call AegisMem (created by ./aegis up; scopes: memory read/write, review, privacy).
AEGIS_MEMORY_API_KEY_FILE=/run/aegis/aegismem-key
