{
  "_comment": "Smoke gates for the small built-in suites (run in CI). The 52-example internal set is hand-written and is NOT a headline metric; headline numbers come from bench/validate.py on real datasets (bench/VALIDATION.md). Raise floors as the product improves; never lower one without a reason in project_log.md.",
  "poisoning": {
    "pipeline_recall": {
      "min": 0.25
    },
    "pipeline_fpr": {
      "max": 0.05
    },
    "user_message_false_positives": {
      "max": 0
    }
  },
  "learning": {
    "recall_gain": {
      "min": 0.05
    },
    "fpr_delta": {
      "max": 0.05
    }
  },
  "revocation": {
    "leaks": {
      "max": 0
    },
    "replacement_rate": {
      "min": 1.0
    }
  },
  "erasure": {
    "residue": {
      "max": 0
    },
    "cascade_recall": {
      "min": 1.0
    },
    "collateral_erasures": {
      "max": 0
    },
    "receipts_valid_and_tamper_evident": {
      "equals": true
    }
  },
  "latency": {
    "write_screening_p95_ms": {
      "max": 5.0
    },
    "read_guard_p95_ms": {
      "max": 25.0
    }
  },
  "external_injection": {
    "cold_fpr": {
      "max": 0.02
    },
    "report50_recall": {
      "min": 0.4
    },
    "report50_fpr": {
      "max": 0.05
    },
    "report20_fpr": {
      "max": 0.05
    }
  }
}
