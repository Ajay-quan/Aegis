    {
      "id": 9,
      "type": "timeseries",
      "title": "How long does a policy check take? (p95)",
      "description": "95th percentile OPA evaluation time.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
