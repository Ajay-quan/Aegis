    {
      "id": 13,
      "type": "table",
      "title": "Recent runs (traces)",
      "description": "Each run is one trace: API request, queue hand-off, worker, policy checks, tool and model calls. Click a trace ID to open it. Spans carry ids and outcomes, never content.",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "limit": 20,
          "query": "{ name = \"run.execute\" }",
          "refId": "A"
        }
      ]
    }
  ],
  "description": "Agent actions, policy decisions, tool health and evidence, with traces per run."
}